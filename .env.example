# PostgreSQL database name. / Имя базы данных PostgreSQL.
POSTGRES_DB=bike_server
# PostgreSQL user name. / Имя пользователя PostgreSQL.
POSTGRES_USER=bike_server
# Strong database password; use a unique 64-character hexadecimal value. / Надёжный пароль базы: используйте уникальную строку из 64 шестнадцатеричных символов.
POSTGRES_PASSWORD=replace_with_a_long_hex_password

# Login for the first administrator account. / Логин первой учётной записи администратора.
BIKE_ADMIN_LOGIN=admin
# First administrator password (12–128 characters). / Пароль первого администратора (12–128 символов).
BIKE_ADMIN_PASSWORD=replace_with_a_long_unique_password

# DNS names clients will use, separated by commas; set before first start. / DNS-имена для подключения клиентов через запятую; укажите до первого запуска.
BIKE_TLS_DNS_NAMES=
# IP addresses clients will use, separated by commas; set before first start. / IP-адреса для подключения клиентов через запятую; укажите до первого запуска.
BIKE_TLS_IP_ADDRESSES=
